# Copy this file to .env.local and adjust as needed.
# The defaults below work out of the box against the Firebase Local Emulator Suite —
# no real Firebase project or billing account required to run the MVP.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-reactiva-territorio
VITE_FIREBASE_STORAGE_BUCKET=demo-reactiva-territorio.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_FIREBASE_EMULATORS=true

# Optional: without this, the map screen shows a list-based placeholder instead of
# a live Google Map. Get a free key at https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=

# To switch to a real Firebase project later:
# 1. Create a project at https://console.firebase.google.com
# 2. Replace the VITE_FIREBASE_* values with your project's web app config
# 3. Set VITE_USE_FIREBASE_EMULATORS=false
